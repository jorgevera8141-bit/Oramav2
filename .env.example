DATABASE_URL=postgres://user:pass@host:5432/db
PORT=3000
# Café-wide passcode (HTTP Basic Auth, any username). Required when NODE_ENV=production:
# the server refuses to start without it. Unset locally to run without the gate.
GATE_PASSCODE=
# Optional: the passcode being retired. Both work while staff re-enter the new one.
GATE_PASSCODE_PREVIOUS=
# Once a manager changes the café passcode in the POS (Más > Accesos), that one replaces GATE_PASSCODE.
# Recovery if it is forgotten: set GATE_FORCE_ENV=1 to use GATE_PASSCODE again, sign in, change it
# in the POS, then remove this variable.
GATE_FORCE_ENV=
